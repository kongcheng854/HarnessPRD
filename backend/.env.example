ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-sonnet-4-20250514
CORS_ORIGINS=http://localhost:5173
HOST=0.0.0.0
PORT=8000
LOG_LLM_METRICS=true
LOG_LEVEL=INFO

# 输入预算；模型窗口与最大输出统一配置在 config/models.yaml。
CHAT_HISTORY_BUDGET=60000
SINGLE_CALL_INPUT_BUDGET=100000
CONTEXT_BUDGET_TOKENS=120000
TOKEN_BUDGET_MODE=warn
TOKEN_ESTIMATOR=tiktoken
TOKEN_ENCODING=cl100k_base
# 使用 DeepSeek 的兼容服务时，配置相应的 OPENAI_BASE_URL 和 OPENAI_API_KEY：
# DEFAULT_LLM_PROVIDER=openai
# DEFAULT_LLM_MODEL=deepseek-v4-flash
# OPENAI_BASE_URL=
